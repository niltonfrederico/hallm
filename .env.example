# Application
DEBUG=false
APP_PORT=8000
ENVIRONMENT=localhost
TIMEZONE=America/Sao_Paulo

# Database
DATABASE_DRIVER=postgres
DATABASE_HOST=postgres.hallm.local
POSTGRES_USER=hallm
POSTGRES_PASSWORD=
POSTGRES_DB=hallm
POSTGRES_PORT=10432

# Db schemas
HALLM_DB_SCHEMA=hallm
LIBRARY_DB_SCHEMA=library

# Model API Keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# RustFS (S3-compatible object storage)
RUSTFS_ENDPOINT=https://rustfs.hallm.local
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=hallm
RUSTFS_REGION=us-east-1
RUSTFS_PRESIGN_EXPIRES=3600

# Valkey (shared cache)
VALKEY_HOST=valkey.hallm.local
VALKEY_PORT=10379
VALKEY_URL=redis://${VALKEY_PASSWORD}:${VALKEY_PORT}/0
VALKEY_PASSWORD=

# Gotify
GOTIFY_URL=https://gotify.hallm.local
GOTIFY_APP_TOKEN=

# Paperless-ngx
PAPERLESS_URL=https://paperless.hallm.local
PAPERLESS_TOKEN=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=kuresto
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=
PAPERLESS_DATABASE_URL=postgres://${PAPERLESS_DB_USER}:${PAPERLESS_DB_PASSWORD}@${DATABASE_HOST}:${POSTGRES_PORT}/${PAPERLESS_DB_NAME}
PAPERLESS_VALKEY_URL=redis://:${VALKEY_PASSWORD}@${VALKEY_HOST}:${VALKEY_PORT}/2

# Glitchtip
GLITCHTIP_DB_SCHEMA=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DATABASE_URL=postgres://${GLITCHTIP_DB_USER}:${GLITCHTIP_DB_PASSWORD}@${DATABASE_HOST}:${POSTGRES_PORT}/${GLITCHTIP_DB_NAME}
GLITCHTIP_VALKEY_URL=redis://:${VALKEY_PASSWORD}@${VALKEY_HOST}:${VALKEY_PORT}/1

# Jupyter Lab
JUPYTER_TOKEN=

# Sure (self-hosted finance)
SURE_URL=https://sure.hallm.local
SURE_SECRET_KEY_BASE=
SURE_DB_NAME=sure
SURE_DB_USER=sure
SURE_DB_PASSWORD=
SURE_DATABASE_URL=postgres://${SURE_DB_USER}:${SURE_DB_PASSWORD}@${DATABASE_HOST}:${POSTGRES_PORT}/${SURE_DB_NAME}
SURE_VALKEY_URL=redis://:${VALKEY_PASSWORD}@${VALKEY_HOST}:${VALKEY_PORT}/3
